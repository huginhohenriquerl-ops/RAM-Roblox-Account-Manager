<Window x:Class="RAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RAM.Controls"
        Title="R.A.M — Roblox Account Manager"
        Width="1180" Height="780" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg.Main}" Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.UI}" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/ram.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Avatar: initial on a tinted circle, photo on top once loaded -->
        <DataTemplate x:Key="Avatar">
            <Grid>
                <Ellipse Fill="{DynamicResource Accent.Soft}"/>
                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                <Ellipse>
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource Img}}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════════════ Sidebar ═════════════════════ -->
        <Border Background="{DynamicResource Bg.Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,2,0,0" VerticalAlignment="Center">
                    <c:Clawd x:Name="BrandClawd" Width="30" Height="20" Animated="True" FollowMouse="False"/>
                    <TextBlock Text="R.A.M" FontFamily="{StaticResource Font.Serif}" FontSize="19" Margin="9,0,0,1"
                               VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,8,10,0">
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Padding="8,7"
                            Click="AddAccount_Click" ToolTip="Ctrl+N">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent}">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Adicionar conta" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Padding="8,7"
                            Click="NewInstance_Click" ToolTip="Abre outra janela do Roblox, sem precisar de conta salva">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent.Soft}">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nova instância do Roblox" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                                       Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>
                    </Button>

                    <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" Tag="home" IsChecked="True" Checked="Nav_Checked" Margin="0,6,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Início" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInstances" Style="{StaticResource Nav}" Tag="instances" Checked="Nav_Checked">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Width="22"/>
                                <TextBlock Text="Instâncias" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Border x:Name="InstanceBadge" HorizontalAlignment="Right" Background="{DynamicResource Accent.Soft}"
                                    CornerRadius="8" Padding="7,1" Visibility="Collapsed">
                                <TextBlock x:Name="InstanceBadgeText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="settings" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Configurações" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10,20,10,4">
                    <Grid Margin="10,0,4,8">
                        <TextBlock x:Name="AccountsHeader" Text="Contas" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                        <Button x:Name="SelectAllBtn" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" Padding="6,2"
                                FontSize="11.5" Content="Selecionar todas" Click="SelectAll_Click"/>
                    </Grid>
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Tag="Buscar contas" Padding="30,6,10,6" FontSize="13"
                                 Background="{DynamicResource Bg.Main}" TextChanged="Search_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="11,0,0,0"
                                   Foreground="{DynamicResource Text.Muted}" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>

                <ListBox x:Name="AccountList" Grid.Row="3" Style="{StaticResource PlainList}" Padding="10,2,6,8"
                         SelectionMode="Extended" ItemContainerStyle="{StaticResource AccountItem}"
                         SelectionChanged="AccountList_SelectionChanged" MouseDoubleClick="AccountList_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}"/>
                                    <Ellipse Width="11" Height="11" Fill="{DynamicResource Success}" Stroke="{DynamicResource Bg.Sidebar}"
                                             StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Text.Primary}"/>
                                    <TextBlock x:Name="sub" Text="{Binding Subtitle}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Text.Muted}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button Style="{StaticResource Btn.IconSm}" Content="&#xE768;" ToolTip="Abrir Roblox (sem jogo)"
                                            Click="QuickLaunch_Click"/>
                                    <Button Style="{StaticResource Btn.IconSm}" Content="&#xE712;" ToolTip="Detalhes da conta"
                                            Click="EditAccount_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                    <Setter TargetName="sub" Property="Foreground" Value="{DynamicResource Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty sidebar hint -->
                <TextBlock x:Name="SidebarEmpty" Grid.Row="3" Style="{StaticResource T.Muted}" Margin="22,10,22,0"
                           Text="Nenhuma conta ainda. Clique em “Adicionar conta” para começar." Visibility="Collapsed"/>

                <!-- Update ready -->
                <Border x:Name="UpdateBanner" Grid.Row="3" VerticalAlignment="Bottom" Margin="10,0,10,8" Padding="12,10"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="12" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.10"/>
                    </Border.Effect>
                    <Grid>
                        <StackPanel Margin="0,0,80,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateBannerTitle" Text="Atualização pronta" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"/>
                            <TextBlock x:Name="UpdateBannerText" Style="{StaticResource T.Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Right" Padding="10,5" FontSize="12"
                                Content="Reiniciar" Click="ApplyUpdate_Click"/>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="10,8">
                    <Grid>
                        <Button x:Name="MultiPill" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Padding="8,6"
                                Click="MultiPill_Click" ToolTip="Clique para ligar/desligar">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10">
                                    <Ellipse x:Name="MultiDotHalo" Fill="{DynamicResource Success.Soft}" Width="10" Height="10"/>
                                    <Ellipse x:Name="MultiDot" Width="6" Height="6" Fill="{DynamicResource Success}"/>
                                </Grid>
                                <TextBlock x:Name="MultiPillText" Text="Multi-instância" Margin="8,0,0,0" FontSize="12.5"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ThemeBtn" Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right" Content="&#xE708;"
                                ToolTip="Alternar tema" Click="ThemeToggle_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════════════════ Main ═════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="PageTitle" Margin="22,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource Text.Muted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Btn.Caption}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource Btn.Caption}" Content="&#xE922;" Click="Maximize_Click"/>
                    <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ─────────── Home ─────────── -->
                <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="740" Margin="36,8,36,48">
                        <c:Clawd x:Name="HeroClawd" Width="132" Height="88" Margin="0,40,0,0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Greeting" Style="{StaticResource T.H1}" HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,20,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SubGreeting" Style="{StaticResource T.Body}" Foreground="{DynamicResource Text.Muted}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>

                        <StackPanel x:Name="EmptyAddBtn" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0"
                                    Visibility="Collapsed">
                            <Button Style="{StaticResource Btn.Primary}" Click="NewInstance_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11"/>
                                    <TextBlock Text="Nova instância do Roblox" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Outline}" Margin="10,0,0,0" Click="AddAccount_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11"/>
                                    <TextBlock Text="Salvar uma conta" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Composer -->
                        <Border x:Name="Composer" Margin="0,30,0,0" Background="{DynamicResource Bg.Card}" CornerRadius="20"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="16,12,12,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.07"/>
                            </Border.Effect>
                            <StackPanel>
                                <ItemsControl x:Name="SelectedChips" Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Bg.Subtle}" CornerRadius="13" Padding="3,3,10,3" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}" Width="20" Height="20"
                                                                      TextElement.FontSize="10"/>
                                                    <TextBlock Text="{Binding Title}" Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Text.Secondary}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox x:Name="PlaceInput" Style="{StaticResource Input.Bare}" FontSize="15.5"
                                         Tag="Cole um Place ID, link de jogo ou de servidor privado…"
                                         TextChanged="PlaceInput_TextChanged" KeyDown="PlaceInput_KeyDown"/>

                                <Grid x:Name="JobRow" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBox x:Name="JobInput" Style="{StaticResource Input}" Background="{DynamicResource Bg.Subtle}"
                                             BorderThickness="0" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Padding="10,7"
                                             Tag="Job ID (opcional) — entrar em um servidor específico" KeyDown="PlaceInput_KeyDown"
                                             TextChanged="PlaceInput_TextChanged"/>
                                </Grid>

                                <Border x:Name="GamePreview" Margin="0,10,0,0" Background="{DynamicResource Bg.Subtle}" CornerRadius="12"
                                        Padding="8" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="9" Background="{DynamicResource Bg.Selected}" ClipToBounds="True">
                                            <Border.OpacityMask>
                                                <VisualBrush>
                                                    <VisualBrush.Visual>
                                                        <Border Width="46" Height="46" CornerRadius="9" Background="Black"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Border.OpacityMask>
                                            <Image x:Name="GameIcon" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="GameName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Text.Primary}"/>
                                            <TextBlock x:Name="GameMeta" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="JobToggle" Style="{StaticResource Btn.Chip}" Click="JobToggle_Click"
                                                ToolTip="Entrar em um servidor específico">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" FontSize="11"/>
                                                <TextBlock Text="Job ID" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Chip}" Margin="6,0,0,0" Click="SelectAll_Click"
                                                ToolTip="Ctrl/Shift + clique na barra lateral para escolher várias">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="12"/>
                                                <TextBlock x:Name="SelectionText" Text="0 contas" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="LaunchHomeBtn" Style="{StaticResource Btn.Ghost}" Content="Abrir sem jogo"
                                                Click="LaunchHome_Click" Margin="0,0,6,0"/>
                                        <Button x:Name="SendBtn" Style="{StaticResource Btn.Send}" Content="&#xE74A;" Click="Launch_Click"
                                                ToolTip="Entrar no jogo (Enter)"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ComposerHint" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                   Text="Ctrl ou Shift + clique na barra lateral para abrir várias contas de uma vez"/>

                        <!-- Recent places -->
                        <ItemsControl x:Name="RecentList" Margin="0,18,0,0" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Btn.Chip}" Margin="4" Padding="5,5,12,5" Click="Recent_Click"
                                            ToolTip="{Binding PlaceId}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Bg.Subtle}">
                                                <Border.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Border Width="20" Height="20" CornerRadius="5" Background="Black"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Border.OpacityMask>
                                                <Image Source="{Binding IconUrl, Converter={StaticResource Img}}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="7,0,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Launch progress -->
                        <Border x:Name="ProgressCard" Style="{StaticResource Card}" Margin="0,22,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <c:Spinner x:Name="LaunchSpinner" FontSize="16" Foreground="{DynamicResource Accent}" Width="20"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LaunchHeadline" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}"/>
                                </StackPanel>
                                <ItemsControl x:Name="LaunchSteps" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="26,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="glyph" Text="&#x2022;" Style="{StaticResource Icon}" FontSize="11"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Text.Primary}"/>
                                                <TextBlock x:Name="status" Grid.Column="2" Text="{Binding Status}" FontSize="12.5"
                                                           Foreground="{DynamicResource Text.Muted}"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Running">
                                                    <Setter TargetName="glyph" Property="Text" Value="&#xE895;"/>
                                                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter TargetName="glyph" Property="Text" Value="&#xE73E;"/>
                                                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter TargetName="glyph" Property="Text" Value="&#xE711;"/>
                                                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─────────── Instances ─────────── -->
                <ScrollViewer x:Name="InstancesPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="860" Margin="36,8,36,48">
                        <Grid Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Instâncias" Style="{StaticResource T.H2}"/>
                                <TextBlock x:Name="InstancesSummary" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource Btn.Outline}" Margin="0,0,8,0" Click="NewInstance_Click"
                                        ToolTip="Abre outra janela do Roblox (sem conta salva)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11"/>
                                        <TextBlock Text="Nova instância" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CloseAllBtn" Style="{StaticResource Btn.Danger}" Click="CloseAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12"/>
                                        <TextBlock Text="Fechar todas" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="54" Height="54" CornerRadius="12" Background="{DynamicResource Accent.Soft}" VerticalAlignment="Top">
                                    <c:Clawd x:Name="MultiClawd" Width="40" Height="27" FollowMouse="False"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0">
                                    <TextBlock Text="Multi-instância" Style="{StaticResource T.H3}"/>
                                    <TextBlock x:Name="MultiStatusText" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource Btn.Outline}" Padding="10,5" FontSize="12.5" Click="ReleaseHandles_Click"
                                                ToolTip="Fecha ROBLOX_singletonEvent/Mutex dentro dos clientes já abertos">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12"/>
                                                <TextBlock Text="Liberar handles agora" Margin="7,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox x:Name="MultiSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Top"
                                          Margin="0,2,0,0" Click="MultiSwitch_Click"/>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="InstanceList" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="38" Height="38">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}"/>
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource Success}" Stroke="{DynamicResource Bg.Card}"
                                                         StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"
                                                           FontFamily="{StaticResource Font.Mono}" FontSize="11.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Btn.Icon}" Content="&#xE8A7;" ToolTip="Trazer para frente" Click="FocusInstance_Click"/>
                                                <Button Style="{StaticResource Btn.Icon}" Content="&#xE711;" ToolTip="Fechar esta instância" Click="CloseInstance_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="InstancesEmpty" Margin="0,36,0,0" HorizontalAlignment="Center">
                            <c:Clawd Width="96" Height="64" Mood="Sleeping" FollowMouse="False"/>
                            <TextBlock Text="Nenhum Roblox aberto agora" Style="{StaticResource T.H3}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            <TextBlock Text="As instâncias abertas pelo R.A.M (ou por você) aparecem aqui." Style="{StaticResource T.Muted}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ─────────── Settings ─────────── -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" Margin="36,8,36,48">
                        <TextBlock Text="Configurações" Style="{StaticResource T.H2}" Margin="0,18,0,0"/>

                        <TextBlock Text="MULTI-INSTÂNCIA" Style="{StaticResource T.Label}" Margin="2,26,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Ativar ao abrir o R.A.M" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="Ocupa o nome ROBLOX_singletonEvent assim que o app inicia, para que cada cliente do Roblox ache que é o único aberto."/>
                                    </StackPanel>
                                    <CheckBox x:Name="SetMultiStartup" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Setting_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Segurar também ROBLOX_singletonMutex" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="Compatibilidade com clientes antigos que usavam um Mutex em vez de um Event."/>
                                    </StackPanel>
                                    <CheckBox x:Name="SetLegacyMutex" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Setting_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Isolar as sessões das contas" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="Trava o RobloxCookies.dat enquanto a multi-instância está ativa, para que cada janela guarde só o próprio login. Evita o erro 773 nos teleportes e uma conta mostrando o histórico de outra. Com isso ligado, “Nova instância do Roblox” pede login a cada janela."/>
                                    </StackPanel>
                                    <CheckBox x:Name="SetIsolate" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Setting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ABERTURA" Style="{StaticResource T.Label}" Margin="2,26,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Como abrir o Roblox" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Style="{StaticResource SettingDesc}"
                                           Text="Pelo protocolo roblox-player:// você mantém seu bootstrapper (Bloxstrap etc.). O modo direto chama o RobloxPlayerBeta.exe instalado."/>
                                <Border Style="{StaticResource SegmentHost}" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SetLaunchProtocol" Style="{StaticResource Segment}" GroupName="launch" Content="Protocolo" Checked="Setting_Changed"/>
                                        <RadioButton x:Name="SetLaunchDirect" Style="{StaticResource Segment}" GroupName="launch" Content="Direto (.exe)" Checked="Setting_Changed"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="LaunchPathText" Style="{StaticResource T.Muted}" FontFamily="{StaticResource Font.Mono}"
                                           FontSize="11.5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Intervalo entre contas" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="Espera entre uma conta e outra ao abrir várias de uma vez."/>
                                    </StackPanel>
                                    <TextBlock x:Name="DelayText" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"/>
                                </Grid>
                                <Slider x:Name="SetDelay" Style="{StaticResource Slider}" Minimum="0" Maximum="30" Margin="0,10,0,0"
                                        ValueChanged="Delay_Changed"/>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Renomear janelas do Roblox" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="Mostra o nome da conta no título de cada janela (“Roblox — conta”)."/>
                                    </StackPanel>
                                    <CheckBox x:Name="SetRename" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Setting_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Fechar a sessão anterior da mesma conta" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="Ao abrir uma conta que já está rodando, fecha a janela antiga antes. Evita o kick “mesma conta em outro dispositivo”."/>
                                    </StackPanel>
                                    <CheckBox x:Name="SetCloseDuplicates" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Setting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="APARÊNCIA E SISTEMA" Style="{StaticResource T.Label}" Margin="2,26,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tema" Style="{StaticResource SettingTitle}"/>
                                <Border Style="{StaticResource SegmentHost}" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SetThemeSystem" Style="{StaticResource Segment}" GroupName="theme" Content="Sistema" Tag="system" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="SetThemeLight" Style="{StaticResource Segment}" GroupName="theme" Content="Claro" Tag="light" Checked="Theme_Checked"/>
                                        <RadioButton x:Name="SetThemeDark" Style="{StaticResource Segment}" GroupName="theme" Content="Escuro" Tag="dark" Checked="Theme_Checked"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Continuar na bandeja ao fechar" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Style="{StaticResource SettingDesc}"
                                                   Text="A multi-instância só funciona enquanto o R.A.M estiver aberto. Na bandeja ele continua segurando o mutex."/>
                                    </StackPanel>
                                    <CheckBox x:Name="SetTray" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="Setting_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource T.Label}" Margin="2,26,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="UpdateVersionText" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingDesc}"/>
                                </StackPanel>
                                <Button x:Name="CheckUpdateBtn" Style="{StaticResource Btn.Outline}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Padding="10,5" FontSize="12.5" Click="CheckUpdate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                                        <TextBlock x:Name="CheckUpdateText" Text="Verificar agora" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="DADOS" Style="{StaticResource T.Label}" Margin="2,26,0,8"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Success}"/>
                                        <TextBlock Text="Cookies criptografados com DPAPI" Style="{StaticResource SettingTitle}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingDesc}"
                                               Text="Só o seu usuário do Windows, neste PC, consegue abrir o arquivo de contas. Nunca compartilhe um cookie .ROBLOSECURITY com ninguém."/>
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Outline}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"
                                        FontSize="12.5" Click="OpenDataFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12"/>
                                        <TextBlock Text="Abrir pasta" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                            <c:Clawd Width="27" Height="18" FollowMouse="False"/>
                            <TextBlock x:Name="AboutText" Style="{StaticResource T.Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═════════════════════ Dialogs ═════════════════════ -->
        <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="{DynamicResource Overlay}" MouseLeftButtonDown="Overlay_MouseDown"/>

            <!-- Add account -->
            <Border x:Name="AddDialog" Style="{StaticResource Dialog}" Width="540">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <c:Clawd x:Name="AddClawd" Width="39" Height="26" FollowMouse="False"/>
                            <TextBlock Text="Adicionar conta" Style="{StaticResource T.H2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource Btn.Icon}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right" Click="CloseDialog_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,14,0,0"
                               Text="Cole o cookie .ROBLOSECURITY de uma ou mais contas — um por linha. Ele é validado no Roblox e guardado criptografado neste PC."/>
                    <TextBox x:Name="CookieInput" Style="{StaticResource Input}" Margin="0,14,0,0" Height="118" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                             Tag="_|WARNING:-DO-NOT-SHARE-THIS.--Sharing-this-will-allow-someone-to-log-in-as-you…"/>
                    <TextBox x:Name="AliasInput" Style="{StaticResource Input}" Margin="0,10,0,0" Tag="Apelido (opcional — só quando for uma conta)"/>

                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Padding="4,4" Margin="-2,10,0,0" FontSize="12.5"
                            Click="CookieHelp_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="12"/>
                            <TextBlock Text="Como encontrar o cookie?" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="CookieHelp" Background="{DynamicResource Bg.Subtle}" CornerRadius="10" Padding="14,10" Margin="0,6,0,0"
                            Visibility="Collapsed">
                        <TextBlock Style="{StaticResource T.Body}" FontSize="12.5" LineHeight="19">
                            1. Entre na conta em roblox.com pelo navegador.<LineBreak/>
                            2. Abra as Ferramentas do desenvolvedor (F12) → Aplicativo/Armazenamento → Cookies → https://www.roblox.com.<LineBreak/>
                            3. Copie o valor de <Run FontFamily="{StaticResource Font.Mono}">.ROBLOSECURITY</Run> e cole acima.<LineBreak/>
                            Dica: use uma janela anônima por conta e feche-a sem sair da conta — “Sair” invalida o cookie.
                        </TextBlock>
                    </Border>

                    <Border x:Name="AddErrorBox" Background="{DynamicResource Danger.Soft}" CornerRadius="10" Padding="12,9" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="AddError" Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource Btn.Ghost}" Content="Cancelar" Click="CloseDialog_Click" Margin="0,0,8,0"/>
                        <Button x:Name="AddConfirmBtn" Style="{StaticResource Btn.Primary}" Click="AddConfirm_Click">
                            <StackPanel Orientation="Horizontal">
                                <c:Spinner x:Name="AddSpinner" Foreground="White" Margin="0,0,8,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="AddConfirmText" Text="Adicionar"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Account details -->
            <Border x:Name="EditDialog" Style="{StaticResource Dialog}" Width="520">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="EditAvatar" Width="56" Height="56" ContentTemplate="{StaticResource Avatar}"
                                          TextElement.FontSize="20"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="EditTitle" Style="{StaticResource T.H2}" FontSize="22" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="EditSubtitle" Style="{StaticResource T.Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Content="&#xE8BB;" FontSize="11" VerticalAlignment="Top"
                                Click="CloseDialog_Click"/>
                    </Grid>

                    <TextBlock Text="APELIDO" Style="{StaticResource T.Label}" Margin="2,20,0,6"/>
                    <TextBox x:Name="EditAlias" Style="{StaticResource Input}" Tag="Como esta conta aparece no R.A.M"/>
                    <TextBlock Text="NOTAS" Style="{StaticResource T.Label}" Margin="2,14,0,6"/>
                    <TextBox x:Name="EditNotes" Style="{StaticResource Input}" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Tag="Ex.: conta alt, farm, grupo…"/>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource Btn.Outline}" Padding="10,6" FontSize="12.5" Margin="0,0,8,8" Click="EditLaunch_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11"/>
                                <TextBlock Text="Abrir Roblox" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditRefreshBtn" Style="{StaticResource Btn.Outline}" Padding="10,6" FontSize="12.5" Margin="0,0,8,8"
                                Click="EditRefresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="11"/>
                                <TextBlock Text="Verificar conta" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Outline}" Padding="10,6" FontSize="12.5" Margin="0,0,8,8" Click="EditProfile_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="11"/>
                                <TextBlock Text="Ver perfil" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Margin="0,14,0,0">
                        <Button x:Name="RemoveBtn" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Left" Click="Remove_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                <TextBlock x:Name="RemoveText" Text="Remover conta" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Ghost}" Content="Cancelar" Click="CloseDialog_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Btn.Primary}" Content="Salvar" Click="EditSave_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═════════════════════ Toast ═════════════════════ -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="276,0,0,26"
                Background="{DynamicResource Tooltip.Bg}" CornerRadius="12" Padding="14,10,16,10" Opacity="0" IsHitTestVisible="False"
                MaxWidth="560">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="12"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13" Foreground="{DynamicResource Tooltip.Fg}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
