<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Claude Desktop — light -->
    <SolidColorBrush x:Key="Bg.Main" Color="#FAF9F5"/>
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#F3F1EA"/>
    <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.Subtle" Color="#F0EEE6"/>
    <SolidColorBrush x:Key="Bg.Hover" Color="#1F1E1D" Opacity="0.055"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#1F1E1D" Opacity="0.09"/>
