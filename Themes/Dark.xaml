<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Claude Desktop — dark -->
    <SolidColorBrush x:Key="Bg.Main" Color="#262624"/>
    <SolidColorBrush x:Key="Bg.Sidebar" Color="#1F1E1D"/>
    <SolidColorBrush x:Key="Bg.Card" Color="#30302E"/>
    <SolidColorBrush x:Key="Bg.Subtle" Color="#2B2A28"/>
    <SolidColorBrush x:Key="Bg.Hover" Color="#FAF9F5" Opacity="0.06"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#FAF9F5" Opacity="0.10"/>
    <SolidColorBrush x:Key="Border" Color="#DEDCD1" Opacity="0.13"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#DEDCD1" Opacity="0.26"/>
    <SolidColorBrush x:Key="Text.Primary" Color="#FAF9F5"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#C2C0B6"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#9C9A92"/>
    <SolidColorBrush x:Key="Text.Inverse" Color="#141413"/>
    <SolidColorBrush x:Key="Accent" Color="#D97757"/>
    <SolidColorBrush x:Key="Accent.Hover" Color="#E08B6E"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#D97757" Opacity="0.20"/>
    <SolidColorBrush x:Key="Success" Color="#6CBF7A"/>
    <SolidColorBrush x:Key="Success.Soft" Color="#6CBF7A" Opacity="0.15"/>
    <SolidColorBrush x:Key="Danger" Color="#E5735F"/>
    <SolidColorBrush x:Key="Danger.Soft" Color="#E5735F" Opacity="0.14"/>
    <SolidColorBrush x:Key="Overlay" Color="#000000" Opacity="0.50"/>
    <SolidColorBrush x:Key="Tooltip.Bg" Color="#FAF9F5"/>
    <SolidColorBrush x:Key="Tooltip.Fg" Color="#141413"/>
</ResourceDictionary>
